  "recommended_cli_command": "python train_sft.py --model Qwen/Qwen3-4B --data-dir data/sft/candidates/v5_expanded --output-dir checkpoints/qwen3-4b-zac-lora-v5-expanded --epochs 3 --batch-size 2 --grad-accum 8 --lr 2e-4 --max-seq-len 8192 --lora-r 32 --lora-alpha 64 --weighted-loss --optimized"
