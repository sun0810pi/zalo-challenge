{
  "description": "SFT V5 Expanded Configuration: 2,917 Diverse Multi-App + ASR-Noise + P1 Concise Rationales on NVIDIA L4/A100",
  "model": "Qwen/Qwen3-4B",
  "data_dir": "data/sft/candidates/v5_expanded",
